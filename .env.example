# Copy to .env for local development; replace the placeholder with a random secret >=32 chars.
DATABASE_URL=postgresql+psycopg://codesentinel:codesentinel@db:5432/codesentinel
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-this-placeholder-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
ALLOWED_TARGET_HOSTS=test-api
ALLOW_PRIVATE_TARGETS=true
SCAN_TIMEOUT_SECONDS=5
SCAN_MAX_REQUESTS=50
SCAN_DELAY_SECONDS=0.1
